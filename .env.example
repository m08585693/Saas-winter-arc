# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Clé service_role - JAMais exposée côté client, uniquement serveur.
# À ajouter dans Vercel Settings > Environment Variables (pas ici).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email)
RESEND_API_KEY=re_your_key
EMAIL_FROM=Arc <no-reply@yourdomain.com>

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# URL de base de l'app (pour les liens dans les emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
